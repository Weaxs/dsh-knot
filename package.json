{
  "name": "@weaxs/dsh-knot",
  "version": "0.3.0",
  "description": "Connect DeepSeek Harness with Hermes, OpenClaw, and remote dsh instances through ACP v1 or native gateways over private networks or loopback.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-knot-acp": "./dist/acp/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:e2e": "node .github/e2e/run.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "release": "node scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.4 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hermes",
    "openclaw",
    "multi-agent",
    "tailscale"
  ],
  "homepage": "https://github.com/Weaxs/dsh-knot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weaxs/dsh-knot.git"
  },
  "bugs": {
    "url": "https://github.com/Weaxs/dsh-knot/issues"
  },
  "author": "Weaxs",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.8.0",
    "ws": "^8.23.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.4 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.4 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
